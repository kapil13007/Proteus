DATABASE_URL=postgresql://mapflow:mapflow@localhost:5433/mapflow

# LLM — get a free key at console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith tracing (optional) — smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mapflow

# GitHub push (optional — leave token empty to skip the push step)
GITHUB_TOKEN=
GITHUB_REPO=kapil13007/dataform-models
GITHUB_BRANCH=main

MAX_DRY_RUN_ATTEMPTS=3

# Auth — signs session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-dev

# LLM cost estimate shown per run — check console.groq.com/pricing for current rates
GROQ_PRICE_PER_1M_INPUT=0.59
GROQ_PRICE_PER_1M_OUTPUT=0.79
