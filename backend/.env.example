# Copy to backend/.env. Everything here is free; only GROQ_API_KEY is needed to start.

# --- LLM: Groq free tier (https://console.groq.com — free key, no card) ------------
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# low = few hidden reasoning tokens: faster and cheaper, plenty for STTM translation
GROQ_REASONING_EFFORT=low
# Reuse verified answers across runs (an unchanged STTM costs 0 tokens)
LLM_CACHE=true
LLM_ROWS_PER_CALL=20
# Total LLM attempts per row (1 generation + repairs of failing rows only)
MAX_REPAIR_ATTEMPTS=3
# Groq list prices per 1M tokens, used only for the "list-price equivalent" metric
# (the free tier bills $0). Check console.groq.com/docs/models for current rates.
GROQ_PRICE_PER_1M_INPUT=0.15
GROQ_PRICE_PER_1M_CACHED_INPUT=0.075
GROQ_PRICE_PER_1M_OUTPUT=0.60

# --- Local storage (defaults live in backend/data/, created on first start) ---------
# DATABASE_URL=sqlite:///D:/path/to/mapflow.db      # app state; any SQLAlchemy URL works
# WAREHOUSE_PATH=D:/path/to/warehouse.duckdb          # local DuckDB warehouse sandbox
SEED_DEMO_DATA=true
SAMPLE_ROWS=200

# --- Optional: publish approved files to your Dataform repo (one commit per run) -----
# Fine-grained PAT with Contents: read & write on that repo. Leave empty to skip.
GITHUB_TOKEN=
GITHUB_REPO=your-username/dataform-models
GITHUB_BRANCH=main

# --- Auth: signs session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-dev-use-a-long-random-string
